#------------------------------
# Project Templates
#------------------------------
# Create new project from base template
new() {
  if [[ "$1" == "base" && -n "$2" ]]; then
    git clone --depth 1 --recurse-submodules https://github.com/traviskirton/base.git "$2" && cd "$2" && rm -rf .git && git init && npm install
  else
    echo "Usage: new base <project-name>"
  fi
}

proj() {
  mkdir "$1" && cd "$1" && git init && code .
}

#------------------------------
# Snapshots
#------------------------------
# Switch between project snapshots (git tags)
snap() {
  # Check if snapshots are set up
  if [[ ! -f ".snapshots/versions" ]]; then
    echo "Snapshots not set up in this project."
    echo -n "Would you like to set them up? (y/n) "
    read -r answer
    if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
      mkdir -p .snapshots
      echo "# Snapshots\n\nTo switch: \`snap <tag>\`\n" > .snapshots/versions
      echo "# Add your build command here" > .snapshots/build
      echo "Created .snapshots/versions and .snapshots/build"
      echo "Edit these files to configure your snapshots."
    fi
    return 1
  fi

  if [[ -z "$1" ]]; then
    echo "Usage: snap <tag>"
    echo ""
    echo "Available snapshots:"
    grep "^## " .snapshots/versions | sed 's/## /  /'
    return 1
  fi

  local tag="$1"

  if ! git rev-parse "$tag" >/dev/null 2>&1; then
    echo "Error: Tag '$tag' not found"
    echo ""
    echo "Available snapshots:"
    grep "^## " .snapshots/versions | sed 's/## /  /'
    return 1
  fi

  git checkout "$tag"

  if [[ -f ".snapshots/build" ]]; then
    echo ""
    echo "Running build..."
    source .snapshots/build
  fi
}
