#------------------------------
# Run Project Commands
#------------------------------
run() {
  case "$1" in
    site)
      (
        cd ~/Dev/portfolio/site || exit 1
        (sleep 1; open http://localhost) &
        python3 -m http.server 80
      )
      ;;
    *)
      echo "usage: run site"
      return 1
      ;;
  esac
}