_chessdir() {
  local base=~/Library/Containers/com.apple.Safari/Data/Library/WebKit/WebsiteData/Default
  local f=$(grep -ral "chess\.com" "$base"/*/*/origin 2>/dev/null | head -1)
  [ -n "$f" ] && dirname "$(dirname "$f")"
}
chesssize() { local d=$(_chessdir); [ -n "$d" ] && du -sh "$d" || echo "no chess.com data"; }
chesspurge() {
  pgrep -q Safari && { echo "quit Safari first"; return 1; }
  local d=$(_chessdir); [ -n "$d" ] && rm -rf "$d" && echo "purged" || echo "nothing to purge"
}

